  <diagram id="overview" name="01 - Tổng quan 20 bảng">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="PCFORGE — PHƯƠNG ÁN CỐT LÕI 20 BẢNG" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=28;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1600" height="55" as="geometry" />
        </mxCell>
        <mxCell id="scope" value="Thiết kế đề xuất cho nhóm 4–5 người / khoảng 3 tháng. Một cửa hàng, một kho, mỗi sản phẩm là một SKU.&#10;Đây là sơ đồ mục tiêu, chưa phải schema SQL đang chạy. Mũi tên ở tab này biểu diễn luồng nghiệp vụ, không phải khóa ngoại." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1700" height="85" as="geometry" />
        </mxCell>
        <mxCell id="account" value="TÀI KHOẢN · 2 bảng&#10;users&#10;user_addresses" style="rounded=1;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;spacing=18;strokeColor=#666666;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="450" height="210" as="geometry" />
        </mxCell>
        <mxCell id="catalog" value="SẢN PHẨM &amp; PHỤ KIỆN · 5 bảng&#10;categories · brands · products&#10;product_images · product_specs" style="rounded=1;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;spacing=18;strokeColor=#666666;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="600" y="220" width="450" height="210" as="geometry" />
        </mxCell>
        <mxCell id="build" value="BUILD PC + AI · 2 bảng&#10;pc_builds&#10;pc_build_items" style="rounded=1;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;spacing=18;strokeColor=#666666;fillColor=#e1d5e7;" vertex="1" parent="1">
          <mxGeometry x="1160" y="220" width="450" height="210" as="geometry" />
        </mxCell>
        <mxCell id="promotion" value="KHUYẾN MÃI · 2 bảng&#10;promotions&#10;promotion_gifts" style="rounded=1;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;spacing=18;strokeColor=#666666;fillColor=#ffe6cc;" vertex="1" parent="1">
          <mxGeometry x="40" y="610" width="450" height="210" as="geometry" />
        </mxCell>
        <mxCell id="commerce" value="GIỎ / ĐƠN / THANH TOÁN · 5 bảng&#10;carts · cart_items · orders&#10;order_items · payments" style="rounded=1;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;spacing=18;strokeColor=#666666;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="600" y="610" width="450" height="210" as="geometry" />
        </mxCell>
        <mxCell id="service" value="BẢO HÀNH / BẢO TRÌ · 3 bảng&#10;purchased_units · service_requests&#10;service_request_history" style="rounded=1;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;spacing=18;strokeColor=#666666;fillColor=#f8cecc;" vertex="1" parent="1">
          <mxGeometry x="1160" y="610" width="450" height="210" as="geometry" />
        </mxCell>
        <mxCell id="review" value="ĐÁNH GIÁ · 1 bảng&#10;reviews&#10;Chỉ khách đã mua" style="rounded=1;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;spacing=18;strokeColor=#666666;fillColor=#b1ddf0;" vertex="1" parent="1">
          <mxGeometry x="600" y="1030" width="450" height="210" as="geometry" />
        </mxCell>
        <mxCell id="flow-0" value="Đăng nhập / đặt hàng" edge="1" parent="1" source="account" target="commerce" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;endArrow=block;endFill=1;strokeColor=#666666;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-1" value="Catalog + thông số đã kiểm chứng" edge="1" parent="1" source="catalog" target="build" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;endArrow=block;endFill=1;strokeColor=#666666;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-2" value="Chọn hàng / kiểm tra tồn" edge="1" parent="1" source="catalog" target="commerce" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;endArrow=block;endFill=1;strokeColor=#666666;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-3" value="Thêm cấu hình vào giỏ" edge="1" parent="1" source="build" target="commerce" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;endArrow=block;endFill=1;strokeColor=#666666;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-4" value="Đủ ngưỡng → quà tặng" edge="1" parent="1" source="promotion" target="commerce" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;endArrow=block;endFill=1;strokeColor=#666666;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-5" value="Giao thành công → từng món được bảo hành" edge="1" parent="1" source="commerce" target="service" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;endArrow=block;endFill=1;strokeColor=#666666;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-6" value="Mua thành công → đánh giá" edge="1" parent="1" source="commerce" target="review" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;endArrow=block;endFill=1;strokeColor=#666666;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="notes" value="QUY TẮC CỐT LÕI&#10;• Backend tính giá và kiểm tra tương thích; AI chỉ chọn sản phẩm có trong catalog.&#10;• Mỗi đơn tối đa một khuyến mãi; quà là dòng order_items giá 0 và phải trừ kho.&#10;• Đơn giữ snapshot địa chỉ/giá/chính sách; mỗi món có purchased_units riêng, serial có thể trống.&#10;• Dùng transaction và khóa duy nhất để chống vượt tồn, đặt trùng và callback lặp.&#10;• Không có đa kho, biến thể nhiều tầng, chia kiện, hoàn tiền một phần hoặc quản lý vật tư sửa chữa.&#10;• Báo cáo tổng hợp trực tiếp từ orders / order_items / payments.&#10;&#10;Mở tab “02 - ERD chi tiết” để xem đầy đủ cột và 28 quan hệ FK. Dùng View → Outline để di chuyển." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="40" y="1360" width="1580" height="300" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

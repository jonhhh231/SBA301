        <object id="orders" label="orders" tooltip="CREATE TABLE orders (&#10;  id BIGINT NOT NULL AUTO_INCREMENT PRIMARY KEY,&#10;  order_number VARCHAR(50) CHARACTER SET ascii COLLATE ascii_bin NOT NULL UNIQUE,&#10;  user_id BIGINT,&#10;  checkout_quote_id BIGINT UNIQUE,&#10;  customer_email VARCHAR(254) NOT NULL,&#10;  customer_phone VARCHAR(25) NOT NULL,&#10;  order_status VARCHAR(25) NOT NULL DEFAULT 'PENDING_CONFIRMATION',&#10;  payment_status VARCHAR(25) NOT NULL DEFAULT 'UNPAID',&#10;  fulfillment_status VARCHAR(25) NOT NULL DEFAULT 'UNFULFILLED',&#10;  currency_code CHAR(3) NOT NULL DEFAULT 'VND',&#10;  subtotal DECIMAL(19,2) NOT NULL,&#10;  discount_amount DECIMAL(19,2) NOT NULL DEFAULT 0,&#10;  shipping_fee DECIMAL(19,2) NOT NULL DEFAULT 0,&#10;  shipping_discount DECIMAL(19,2) NOT NULL DEFAULT 0,&#10;  service_amount DECIMAL(19,2) NOT NULL DEFAULT 0,&#10;  tax_amount DECIMAL(19,2) NOT NULL DEFAULT 0,&#10;  grand_total DECIMAL(19,2) NOT NULL,&#10;  customer_note VARCHAR(2000),&#10;  invoice_snapshot JSON,&#10;  placed_at DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),&#10;  confirmed_at DATETIME(6),&#10;  completed_at DATETIME(6),&#10;  cancelled_at DATETIME(6),&#10;  updated_at DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6) ON UPDATE CURRENT_TIMESTAMP(6),&#10;  version BIGINT NOT NULL DEFAULT 0,&#10;  KEY ix_order_user_date (user_id, placed_at),&#10;  KEY ix_order_status_date (order_status, placed_at),&#10;  KEY ix_order_payment_date (payment_status, placed_at),&#10;  FOREIGN KEY (user_id) REFERENCES users(id),&#10;  FOREIGN KEY (checkout_quote_id) REFERENCES checkout_quotes(id),&#10;  CHECK (order_status IN ('PENDING_CONFIRMATION','CONFIRMED','PROCESSING','COMPLETED','CANCELLED')),&#10;  CHECK (payment_status IN ('UNPAID','PENDING','PARTIALLY_PAID','PAID','PARTIALLY_REFUNDED','REFUNDED','FAILED')),&#10;  CHECK (fulfillment_status IN ('UNFULFILLED','PARTIAL','SHIPPED','DELIVERED','FAILED','RETURNED')),&#10;  CHECK (subtotal &gt;= 0 AND discount_amount BETWEEN 0 AND subtotal),&#10;  CHECK (shipping_fee &gt;= 0 AND shipping_discount BETWEEN 0 AND shipping_fee),&#10;  CHECK (service_amount &gt;= 0 AND tax_amount &gt;= 0 AND grand_total &gt;= 0),&#10;  CHECK (grand_total = subtotal - discount_amount + shipping_fee - shipping_discount + service_amount)&#10;) ENGINE=InnoDB;">

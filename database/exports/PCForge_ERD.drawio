        <object id="ai_runs" label="ai_runs" tooltip="CREATE TABLE ai_runs (&#10;  id BIGINT NOT NULL AUTO_INCREMENT PRIMARY KEY,&#10;  build_request_id BIGINT NOT NULL,&#10;  provider VARCHAR(60) NOT NULL,&#10;  model_name VARCHAR(150) NOT NULL,&#10;  prompt_version VARCHAR(50) NOT NULL,&#10;  status VARCHAR(20) NOT NULL,&#10;  input_tokens INT NOT NULL DEFAULT 0,&#10;  output_tokens INT NOT NULL DEFAULT 0,&#10;  cost_amount DECIMAL(19,6),&#10;  cost_currency CHAR(3),&#10;  error_code VARCHAR(80),&#10;  started_at DATETIME(6) NOT NULL,&#10;  finished_at DATETIME(6),&#10;  FOREIGN KEY (build_request_id) REFERENCES build_requests(id),&#10;  CHECK (status IN ('RUNNING','COMPLETED','FAILED','TIMEOUT')),&#10;  CHECK (input_tokens &gt;= 0 AND output_tokens &gt;= 0 AND cost_amount &gt;= 0)&#10;) ENGINE=InnoDB;">

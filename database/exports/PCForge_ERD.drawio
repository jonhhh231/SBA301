        <object id="order_items" label="order_items [REF]" tooltip="CREATE TABLE order_items (&#10;  id BIGINT NOT NULL AUTO_INCREMENT PRIMARY KEY,&#10;  order_id BIGINT NOT NULL,&#10;  variant_id BIGINT NOT NULL,&#10;  build_revision_id BIGINT,&#10;  build_group_key CHAR(36) CHARACTER SET ascii COLLATE ascii_bin,&#10;  sku_snapshot VARCHAR(80) NOT NULL,&#10;  name_snapshot VARCHAR(255) NOT NULL,&#10;  spec_snapshot JSON,&#10;  warranty_policy_snapshot JSON,&#10;  quantity INT NOT NULL,&#10;  unit_price DECIMAL(19,2) NOT NULL,&#10;  discount_amount DECIMAL(19,2) NOT NULL DEFAULT 0,&#10;  tax_rate DECIMAL(5,2) NOT NULL DEFAULT 0,&#10;  tax_amount DECIMAL(19,2) NOT NULL DEFAULT 0,&#10;  unit_cost DECIMAL(19,2),&#10;  is_gift BOOLEAN NOT NULL DEFAULT FALSE,&#10;  requires_serial BOOLEAN NOT NULL DEFAULT FALSE,&#10;  line_total DECIMAL(19,2) GENERATED ALWAYS AS (quantity * unit_price - discount_amount) STORED,&#10;  UNIQUE KEY uk_order_item_pair (order_id, id),&#10;  FOREIGN KEY (order_id) REFERENCES orders(id),&#10;  FOREIGN KEY (variant_id) REFERENCES product_variants(id),&#10;  FOREIGN KEY (build_revision_id) REFERENCES pc_build_revisions(id),&#10;  CHECK (quantity &gt; 0 AND unit_price &gt;= 0 AND unit_cost &gt;= 0),&#10;  CHECK (discount_amount BETWEEN 0 AND quantity * unit_price),&#10;  CHECK (tax_rate BETWEEN 0 AND 100 AND tax_amount &gt;= 0)&#10;) ENGINE=InnoDB;">

        <object id="payment_transactions" label="payment_transactions" tooltip="CREATE TABLE payment_transactions (&#10;  id BIGINT NOT NULL AUTO_INCREMENT PRIMARY KEY,&#10;  payment_id BIGINT NOT NULL,&#10;  provider VARCHAR(40) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,&#10;  merchant_reference VARCHAR(100) CHARACTER SET ascii COLLATE ascii_bin NOT NULL UNIQUE,&#10;  provider_transaction_id VARCHAR(150) CHARACTER SET ascii COLLATE ascii_bin,&#10;  transaction_type VARCHAR(15) NOT NULL,&#10;  amount DECIMAL(19,2) NOT NULL,&#10;  status VARCHAR(15) NOT NULL,&#10;  response_code VARCHAR(80),&#10;  sanitized_metadata JSON,&#10;  occurred_at DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),&#10;  UNIQUE KEY uk_provider_transaction (provider, provider_transaction_id, transaction_type),&#10;  FOREIGN KEY (payment_id) REFERENCES payments(id),&#10;  CHECK (transaction_type IN ('AUTHORIZE','CAPTURE','SALE','VOID','COD_COLLECT')),&#10;  CHECK (status IN ('PENDING','SUCCEEDED','FAILED')),&#10;  CHECK (amount &gt; 0)&#10;) ENGINE=InnoDB;">
          <mxCell style="swimlane;html=0;startSize=34;horizontal=1;rounded=0;collapsible=0;fontStyle=1;fontSize=14;fillColor=#cce5ff;swimlaneFillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=10;" vertex="1" parent="1">
            <mxGeometry x="790" y="150" width="560" height="287" as="geometry" />

        <object id="serial_units" label="serial_units" tooltip="CREATE TABLE serial_units (&#10;  id BIGINT NOT NULL AUTO_INCREMENT PRIMARY KEY,&#10;  variant_id BIGINT NOT NULL,&#10;  serial_namespace VARCHAR(80) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,&#10;  serial_number VARCHAR(150) NOT NULL,&#10;  serial_normalized VARCHAR(150) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,&#10;  receipt_item_id BIGINT,&#10;  warehouse_id BIGINT,&#10;  location_id BIGINT,&#10;  lifecycle_status VARCHAR(25) NOT NULL DEFAULT 'IN_STOCK',&#10;  stock_condition VARCHAR(20) NOT NULL DEFAULT 'SELLABLE',&#10;  bios_version VARCHAR(80),&#10;  unit_cost DECIMAL(19,2),&#10;  created_at DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),&#10;  updated_at DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6) ON UPDATE CURRENT_TIMESTAMP(6),&#10;  version BIGINT NOT NULL DEFAULT 0,&#10;  UNIQUE KEY uk_serial_namespace (serial_namespace, serial_normalized),&#10;  KEY ix_serial_lookup (serial_normalized),&#10;  KEY ix_serial_stock (variant_id, warehouse_id, lifecycle_status),&#10;  FOREIGN KEY (variant_id) REFERENCES product_variants(id),&#10;  FOREIGN KEY (receipt_item_id) REFERENCES goods_receipt_items(id),&#10;  FOREIGN KEY (warehouse_id) REFERENCES warehouses(id),&#10;  FOREIGN KEY (warehouse_id, location_id) REFERENCES warehouse_locations(warehouse_id, id),&#10;  CHECK (location_id IS NULL OR warehouse_id IS NOT NULL),&#10;  CHECK (lifecycle_status IN ('IN_STOCK','RESERVED','SOLD','IN_TRANSIT','IN_SERVICE','RETURNED','RETIRED')),&#10;  CHECK (stock_condition IN ('SELLABLE','QUARANTINE','DAMAGED')),&#10;  CHECK (unit_cost &gt;= 0)&#10;) ENGINE=InnoDB;">

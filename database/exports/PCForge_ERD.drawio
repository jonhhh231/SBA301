        <object id="inventory_movements" label="inventory_movements" tooltip="CREATE TABLE inventory_movements (&#10;  id BIGINT NOT NULL AUTO_INCREMENT PRIMARY KEY,&#10;  inventory_balance_id BIGINT NOT NULL,&#10;  movement_type VARCHAR(25) NOT NULL,&#10;  quantity_delta INT NOT NULL,&#10;  serial_unit_id BIGINT,&#10;  receipt_item_id BIGINT,&#10;  order_item_id BIGINT,&#10;  transfer_item_id BIGINT,&#10;  return_item_id BIGINT,&#10;  repair_part_id BIGINT,&#10;  operation_key VARCHAR(120) CHARACTER SET ascii COLLATE ascii_bin NOT NULL UNIQUE,&#10;  reason VARCHAR(1000),&#10;  created_by BIGINT,&#10;  created_at DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),&#10;  KEY ix_movement_balance_date (inventory_balance_id, created_at),&#10;  FOREIGN KEY (inventory_balance_id) REFERENCES inventory_balances(id),&#10;  FOREIGN KEY (serial_unit_id) REFERENCES serial_units(id),&#10;  FOREIGN KEY (receipt_item_id) REFERENCES goods_receipt_items(id),&#10;  FOREIGN KEY (order_item_id) REFERENCES order_items(id),&#10;  FOREIGN KEY (transfer_item_id) REFERENCES stock_transfer_items(id),&#10;  FOREIGN KEY (return_item_id) REFERENCES return_request_items(id),&#10;  FOREIGN KEY (repair_part_id) REFERENCES repair_parts(id),&#10;  FOREIGN KEY (created_by) REFERENCES users(id),&#10;  CHECK (quantity_delta &lt;&gt; 0),&#10;  CHECK (serial_unit_id IS NULL OR ABS(quantity_delta) = 1),&#10;  CHECK (movement_type IN ('RECEIPT','SALE','RETURN','TRANSFER_IN','TRANSFER_OUT','ADJUSTMENT','REPAIR_USE','CONDITION_CHANGE'))&#10;) ENGINE=InnoDB;">

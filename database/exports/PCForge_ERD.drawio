        <object id="inventory_balances" label="inventory_balances" tooltip="CREATE TABLE inventory_balances (&#10;  id BIGINT NOT NULL AUTO_INCREMENT PRIMARY KEY,&#10;  warehouse_id BIGINT NOT NULL,&#10;  variant_id BIGINT NOT NULL,&#10;  stock_condition VARCHAR(20) NOT NULL DEFAULT 'SELLABLE',&#10;  on_hand INT NOT NULL DEFAULT 0,&#10;  reserved INT NOT NULL DEFAULT 0,&#10;  available INT GENERATED ALWAYS AS (on_hand - reserved) STORED,&#10;  reorder_point INT NOT NULL DEFAULT 0,&#10;  version BIGINT NOT NULL DEFAULT 0,&#10;  updated_at DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6) ON UPDATE CURRENT_TIMESTAMP(6),&#10;  UNIQUE KEY uk_inventory_bucket (warehouse_id, variant_id, stock_condition),&#10;  KEY ix_inventory_sku (variant_id, stock_condition, available),&#10;  FOREIGN KEY (warehouse_id) REFERENCES warehouses(id),&#10;  FOREIGN KEY (variant_id) REFERENCES product_variants(id),&#10;  CHECK (stock_condition IN ('SELLABLE','QUARANTINE','DAMAGED')),&#10;  CHECK (on_hand &gt;= 0 AND reserved &gt;= 0 AND reserved &lt;= on_hand AND reorder_point &gt;= 0),&#10;  CHECK (stock_condition = 'SELLABLE' OR reserved = 0)&#10;) ENGINE=InnoDB;">

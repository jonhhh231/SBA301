  <diagram id="views" name="12 - Reporting views (dashed arrows = SQL dependencies)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="heading" value="12 - Reporting views (dashed arrows = SQL dependencies)" style="text;html=0;align=left;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="PK: primary key | FK: foreign key | UK: member of a unique key (may be composite) | NN: NOT NULL | AI: auto increment | GEN: generated&#10;Parent -&gt; child: 1 or 0..1 at parent; 0..N or 0..1 at child. Gray tables: references from another module. SQL constraints: hover over table." style="text;html=0;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="65" width="2400" height="55" as="geometry" />
        </mxCell>
        <mxCell id="v_sellable_inventory" value="v_sellable_inventory&#10;&#10;SELECT b.variant_id, SUM(b.on_hand) AS on_hand,&#10;       SUM(b.reserved) AS reserved, SUM(b.available) AS available&#10;FROM inventory_balances b&#10;JOIN warehouses w ON w.id = b.warehouse_id AND w.is_active = 1&#10;WHERE b.stock_condition = 'SELLABLE'&#10;GROUP BY b.variant_id" style="rounded=0;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontFamily=Consolas;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="800" y="150" width="1100" height="167" as="geometry" />
        </mxCell>
        <mxCell id="v_product_ratings" value="v_product_ratings&#10;&#10;SELECT product_id, COUNT(*) AS review_count, ROUND(AVG(rating), 2) AS average_rating&#10;FROM reviews WHERE status = 'APPROVED' GROUP BY product_id" style="rounded=0;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontFamily=Consolas;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="800" y="800" width="1100" height="99" as="geometry" />
        </mxCell>
        <mxCell id="v_daily_completed_orders" value="v_daily_completed_orders&#10;&#10;SELECT DATE(CONVERT_TZ(completed_at, '+00:00', '+07:00')) AS report_date,&#10;       currency_code, COUNT(*) AS completed_orders,&#10;       SUM(subtotal) AS gross_item_amount, SUM(discount_amount) AS item_discount,&#10;       SUM(grand_total) AS completed_order_value&#10;FROM orders&#10;WHERE order_status = 'COMPLETED' AND completed_at IS NOT NULL&#10;GROUP BY DATE(CONVERT_TZ(completed_at, '+00:00', '+07:00')), currency_code" style="rounded=0;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontFamily=Consolas;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="800" y="1450" width="1100" height="184" as="geometry" />
        </mxCell>
        <mxCell id="v_daily_cash_flow" value="v_daily_cash_flow&#10;&#10;SELECT report_date, currency_code, SUM(cash_in) AS cash_in,&#10;       SUM(cash_out) AS cash_out, SUM(cash_in) - SUM(cash_out) AS net_cash&#10;FROM (&#10;  SELECT DATE(CONVERT_TZ(t.occurred_at, '+00:00', '+07:00')) AS report_date,&#10;         p.currency_code, t.amount AS cash_in, CAST(0 AS DECIMAL(19,2)) AS cash_out&#10;  FROM payment_transactions t JOIN payments p ON p.id = t.payment_id&#10;  WHERE t.status = 'SUCCEEDED' AND t.transaction_type IN ('CAPTURE','SALE','COD_COLLECT')&#10;  UNION ALL&#10;  SELECT DATE(CONVERT_TZ(r.completed_at, '+00:00', '+07:00')),&#10;         p.currency_code, CAST(0 AS DECIMAL(19,2)), r.amount&#10;  FROM refunds r JOIN payments p ON p.id = r.payment_id&#10;  WHERE r.status = 'SUCCEEDED' AND r.completed_at IS NOT NULL&#10;) cash_movements&#10;GROUP BY report_date, currency_code" style="rounded=0;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontFamily=Consolas;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="800" y="2100" width="1100" height="303" as="geometry" />
        </mxCell>
        <mxCell id="v_best_selling_variants" value="v_best_selling_variants&#10;&#10;SELECT oi.variant_id, o.currency_code, SUM(oi.quantity) AS sold_quantity,&#10;       SUM(oi.line_total) AS item_sales_before_returns,&#10;       SUM(oi.quantity * oi.unit_cost) AS recorded_cost_before_returns&#10;FROM order_items oi JOIN orders o ON o.id = oi.order_id&#10;WHERE o.order_status = 'COMPLETED' AND oi.is_gift = 0&#10;GROUP BY oi.variant_id, o.currency_code" style="rounded=0;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontFamily=Consolas;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="800" y="2750" width="1100" height="167" as="geometry" />
        </mxCell>
        <mxCell id="v_daily_session_conversion" value="v_daily_session_conversion&#10;&#10;SELECT DATE(CONVERT_TZ(s.started_at, '+00:00', '+07:00')) AS cohort_date,&#10;       COUNT(*) AS sessions,&#10;       SUM(CASE WHEN converted.session_id IS NOT NULL THEN 1 ELSE 0 END) AS converted_sessions,&#10;       ROUND(100.0 * SUM(CASE WHEN converted.session_id IS NOT NULL THEN 1 ELSE 0 END) / COUNT(*), 2) AS conversion_percent&#10;FROM analytics_sessions s&#10;LEFT JOIN (&#10;  SELECT DISTINCT e.session_id&#10;  FROM analytics_events e JOIN orders o ON o.id = e.order_id&#10;  WHERE e.event_type = 'PURCHASE' AND o.order_status IN ('CONFIRMED','PROCESSING','COMPLETED')&#10;) converted ON converted.session_id = s.id&#10;WHERE s.is_bot = 0 AND s.consent_status IN ('GRANTED','NOT_REQUIRED')&#10;GROUP BY DATE(CONVERT_TZ(s.started_at, '+00:00', '+07:00'))" style="rounded=0;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontFamily=Consolas;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="800" y="3400" width="1100" height="269" as="geometry" />
        </mxCell>
        <mxCell id="analytics_events" value="analytics_events" style="rounded=1;html=0;fillColor=#dae8fc;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="450" height="60" as="geometry" />
        </mxCell>

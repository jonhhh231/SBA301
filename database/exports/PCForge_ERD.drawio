        <object id="build_requests" label="build_requests" tooltip="CREATE TABLE build_requests (&#10;  id BIGINT NOT NULL AUTO_INCREMENT PRIMARY KEY,&#10;  user_id BIGINT,&#10;  guest_token_hash BINARY(32),&#10;  budget DECIMAL(19,2) NOT NULL,&#10;  currency_code CHAR(3) NOT NULL DEFAULT 'VND',&#10;  budget_scope VARCHAR(20) NOT NULL DEFAULT 'TOWER',&#10;  usage_profile_id BIGINT,&#10;  user_prompt TEXT,&#10;  preferences JSON NOT NULL,&#10;  status VARCHAR(20) NOT NULL DEFAULT 'PENDING',&#10;  created_at DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),&#10;  KEY ix_build_request_user (user_id, created_at),&#10;  FOREIGN KEY (user_id) REFERENCES users(id),&#10;  FOREIGN KEY (usage_profile_id) REFERENCES usage_profiles(id),&#10;  CHECK (budget &gt; 0),&#10;  CHECK ((user_id IS NOT NULL) + (guest_token_hash IS NOT NULL) = 1),&#10;  CHECK (budget_scope IN ('TOWER','FULL_SETUP','CHECKOUT_TOTAL')),&#10;  CHECK (status IN ('PENDING','RUNNING','COMPLETED','NO_SOLUTION','FAILED'))&#10;) ENGINE=InnoDB;">

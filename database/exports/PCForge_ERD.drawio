        <object id="promotion_actions" label="promotion_actions" tooltip="CREATE TABLE promotion_actions (&#10;  id BIGINT NOT NULL AUTO_INCREMENT PRIMARY KEY,&#10;  promotion_version_id BIGINT NOT NULL,&#10;  action_type VARCHAR(25) NOT NULL,&#10;  amount DECIMAL(19,2),&#10;  percent_value DECIMAL(5,2),&#10;  max_discount DECIMAL(19,2),&#10;  gift_quantity INT,&#10;  configuration JSON NOT NULL,&#10;  sort_order INT NOT NULL DEFAULT 0,&#10;  FOREIGN KEY (promotion_version_id) REFERENCES promotion_versions(id),&#10;  CHECK (action_type IN ('FIXED_DISCOUNT','PERCENT_DISCOUNT','GIFT','FREE_SHIPPING','SHIPPING_DISCOUNT')),&#10;  CHECK (amount &gt;= 0 AND percent_value BETWEEN 0 AND 100 AND max_discount &gt;= 0 AND gift_quantity &gt; 0),&#10;  CHECK (action_type NOT IN ('FIXED_DISCOUNT','SHIPPING_DISCOUNT') OR amount IS NOT NULL),&#10;  CHECK (action_type &lt;&gt; 'PERCENT_DISCOUNT' OR percent_value IS NOT NULL),&#10;  CHECK (action_type &lt;&gt; 'GIFT' OR gift_quantity IS NOT NULL)&#10;) ENGINE=InnoDB;">

        <object id="shipments" label="shipments" tooltip="CREATE TABLE shipments (&#10;  id BIGINT NOT NULL AUTO_INCREMENT PRIMARY KEY,&#10;  order_id BIGINT NOT NULL,&#10;  warehouse_id BIGINT NOT NULL,&#10;  shipping_method_id BIGINT NOT NULL,&#10;  tracking_number VARCHAR(150) CHARACTER SET ascii COLLATE ascii_bin,&#10;  status VARCHAR(20) NOT NULL DEFAULT 'PENDING',&#10;  actual_fee DECIMAL(19,2),&#10;  cod_amount DECIMAL(19,2) NOT NULL DEFAULT 0,&#10;  shipped_at DATETIME(6),&#10;  delivered_at DATETIME(6),&#10;  created_at DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),&#10;  UNIQUE KEY uk_shipment_tracking (shipping_method_id, tracking_number),&#10;  FOREIGN KEY (order_id) REFERENCES orders(id),&#10;  FOREIGN KEY (warehouse_id) REFERENCES warehouses(id),&#10;  FOREIGN KEY (shipping_method_id) REFERENCES shipping_methods(id),&#10;  CHECK (status IN ('PENDING','READY','SHIPPED','DELIVERED','FAILED','RETURNED','CANCELLED')),&#10;  CHECK (actual_fee &gt;= 0 AND cod_amount &gt;= 0)&#10;) ENGINE=InnoDB;">
          <mxCell style="swimlane;html=0;startSize=34;horizontal=1;rounded=0;collapsible=0;fontStyle=1;fontSize=14;fillColor=#b1ddf0;swimlaneFillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=10;" vertex="1" parent="1">

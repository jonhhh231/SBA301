        <mxCell id="heading" value="10 - PAYMENTS / WEBHOOKS / REFUNDS (orders and repair services)" style="text;html=0;align=left;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="PK: primary key | FK: foreign key | UK: member of a unique key (may be composite) | NN: NOT NULL | AI: auto increment | GEN: generated&#10;Parent -&gt; child: 1 or 0..1 at parent; 0..N or 0..1 at child. Gray tables: references from another module. SQL constraints: hover over table." style="text;html=0;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="65" width="2400" height="55" as="geometry" />
        </mxCell>
        <object id="payments" label="payments" tooltip="CREATE TABLE payments (&#10;  id BIGINT NOT NULL AUTO_INCREMENT PRIMARY KEY,&#10;  payment_reference VARCHAR(80) CHARACTER SET ascii COLLATE ascii_bin NOT NULL UNIQUE,&#10;  order_id BIGINT,&#10;  repair_estimate_id BIGINT,&#10;  method VARCHAR(20) NOT NULL,&#10;  amount DECIMAL(19,2) NOT NULL,&#10;  currency_code CHAR(3) NOT NULL DEFAULT 'VND',&#10;  status VARCHAR(20) NOT NULL DEFAULT 'PENDING',&#10;  expires_at DATETIME(6),&#10;  paid_at DATETIME(6),&#10;  created_at DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),&#10;  version BIGINT NOT NULL DEFAULT 0,&#10;  FOREIGN KEY (order_id) REFERENCES orders(id),&#10;  FOREIGN KEY (repair_estimate_id) REFERENCES repair_estimates(id),&#10;  CHECK ((order_id IS NOT NULL) + (repair_estimate_id IS NOT NULL) = 1),&#10;  CHECK (method IN ('VNPAY','MOMO','CARD','COD','BANK_TRANSFER','CASH')),&#10;  CHECK (amount &gt; 0),&#10;  CHECK (status IN ('PENDING','AUTHORIZED','SUCCEEDED','FAILED','CANCELLED','EXPIRED'))&#10;) ENGINE=InnoDB;">
          <mxCell style="swimlane;html=0;startSize=34;horizontal=1;rounded=0;collapsible=0;fontStyle=1;fontSize=14;fillColor=#cce5ff;swimlaneFillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=10;" vertex="1" parent="1">
            <mxGeometry x="40" y="150" width="560" height="310" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="payments.id" value="PK         id : BIGINT  NN AI" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=8;fontFamily=Consolas;fontSize=11;overflow=hidden;fontStyle=1;" vertex="1" parent="payments">
          <mxGeometry x="0" y="34" width="560" height="23" as="geometry" />

        <object id="checkout_quotes" label="checkout_quotes" tooltip="CREATE TABLE checkout_quotes (&#10;  id BIGINT NOT NULL AUTO_INCREMENT PRIMARY KEY,&#10;  cart_id BIGINT NOT NULL,&#10;  shipping_quote_id BIGINT,&#10;  coupon_id BIGINT,&#10;  currency_code CHAR(3) NOT NULL DEFAULT 'VND',&#10;  subtotal DECIMAL(19,2) NOT NULL,&#10;  discount_amount DECIMAL(19,2) NOT NULL DEFAULT 0,&#10;  shipping_fee DECIMAL(19,2) NOT NULL DEFAULT 0,&#10;  shipping_discount DECIMAL(19,2) NOT NULL DEFAULT 0,&#10;  service_amount DECIMAL(19,2) NOT NULL DEFAULT 0,&#10;  tax_amount DECIMAL(19,2) NOT NULL DEFAULT 0,&#10;  grand_total DECIMAL(19,2) NOT NULL,&#10;  pricing_snapshot JSON NOT NULL,&#10;  expires_at DATETIME(6) NOT NULL,&#10;  status VARCHAR(15) NOT NULL DEFAULT 'ACTIVE',&#10;  created_at DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),&#10;  FOREIGN KEY (cart_id) REFERENCES carts(id),&#10;  FOREIGN KEY (shipping_quote_id) REFERENCES shipping_quotes(id),&#10;  FOREIGN KEY (coupon_id) REFERENCES coupons(id),&#10;  CHECK (subtotal &gt;= 0 AND discount_amount BETWEEN 0 AND subtotal),&#10;  CHECK (shipping_fee &gt;= 0 AND shipping_discount BETWEEN 0 AND shipping_fee),&#10;  CHECK (service_amount &gt;= 0 AND tax_amount &gt;= 0 AND grand_total &gt;= 0),&#10;  CHECK (grand_total = subtotal - discount_amount + shipping_fee - shipping_discount + service_amount),&#10;  CHECK (status IN ('ACTIVE','CONSUMED','EXPIRED','INVALIDATED'))&#10;) ENGINE=InnoDB;">
